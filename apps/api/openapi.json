          "updatedAt": {
            "description": "Last update timestamp",
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "description": "Canonical HTTP(S) URL",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ownerId",
          "title",
          "url",
          "image",
          "notes",
          "tags",
          "createdAt",
          "updatedAt"
        ],
