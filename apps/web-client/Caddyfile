{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Port {port}
		}
	}

	handle /healthz {
		reverse_proxy api:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Port {port}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
