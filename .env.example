# Local-only settings. Do not reuse these placeholder secrets elsewhere.
# Use letters, numbers, hyphens, and underscores so DATABASE_URL needs no escaping.
POSTGRES_USER=signet
POSTGRES_DB=signet
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password

# Replace with a random URL-safe value of at least 64 characters.
SECRET_KEY_BASE=replace-with-a-random-local-secret-of-at-least-64-characters

# Public browser hostname used by Phoenix; no scheme or port.
PHX_HOST=localhost

# The web app is available at http://localhost:8080 by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
