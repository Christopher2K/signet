        {
          "type": "text",
          "id": "MRvzy",
          "name": "Intro",
          "fill": "#3C3744",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The Stack: three bookmark tabs stepped down and across, mist → azure → cobalt from back to front. One collection, every client (website, extension, mobile); the deepest blue is the one you touch. The mark ships as four optical masters (16 / 24 / 32 / 48) instead of one scaled drawing, so it stays crisp from a 16px favicon to a 1024px app icon.",
          "lineHeight": 1.6,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
