        {
          "type": "text",
          "id": "yhu0d",
          "name": "Note",
          "fill": "#6B6578",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Each master is drawn on its own pixel grid (one grid cell = 1px at its design size), shown here enlarged to 192px. Never scale one master into another range. Geometry: tab = rounded top (radius r), straight sides, V-notch of depth n; the gap is a cut in the background colour around every tab except the back one.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 12,
          "fontWeight": "normal"
        },
