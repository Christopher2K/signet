{
  "name": "@signet/design-system",
  "version": "1.0.0",
  "description": "Signet's cross-platform React Strict DOM design system.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": {
      "types": "./src/tokens.css.ts",
      "default": "./src/tokens.css.ts"
    },
    "./native-theme": {
      "types": "./src/native-theme.ts",
      "default": "./src/native-theme.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-strict-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": ">=0.79.5"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "10.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:"
  },
  "license": "ISC"
}
